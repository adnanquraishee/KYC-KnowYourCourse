{
  "version": 2,
  "buildCommand": "cd gui && npm install && npm run build",
  "outputDirectory": "gui/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "catalogue_chunks.json",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/chat",
      "destination": "/api/index.py"
    },
    {
      "source": "/upload",
      "destination": "/api/index.py"
    }
  ]
}
