{
  "buildCommand": "npm run build",
  "outputDirectory": "gui/dist",
  "functions": {
    "api.py": {
      "includeFiles": "{catalogue_chunks.json,catalogue.pdf}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api.py"
    },
    {
      "source": "/health",
      "destination": "/api.py"
    },
    {
      "source": "/chat",
      "destination": "/api.py"
    },
    {
      "source": "/upload",
      "destination": "/api.py"
    }
  ]
}
