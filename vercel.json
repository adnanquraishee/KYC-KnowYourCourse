{
  "buildCommand": "cd gui && npm install && npm run build",
  "outputDirectory": "gui/dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/chat",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index.py"
    }
  ]
}
